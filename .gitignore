# -------------------------------
# 📦 Finanzapp .gitignore
# Monorepo: Node/Expo + Python + Docker
# -------------------------------

###############################
# 1. Node / React-Native / Expo
###############################
**/node_modules/
**/.expo/
# Web build artifacts
**/web-build/

# Env & config
**/.env
**/.env.*

# Logs & reports
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/coverage/

# iOS / Android artifacts (RN eject)
ios/
android/
*.keystore

################
# 2. Python
################
# Virtual environments
**/venv/
**/env/
**/.venv/

# Byte-compiled / cache
**/__pycache__/
**/*.py[cod]

# Packaging
# Remove build artifacts regardless of language
**/build/
**/dist/
**/*.egg-info/

################
# 3. Model files
backend/models/*
!backend/models/.gitkeep
!backend/models/README.md
################
**/*.gguf
**/*.pt
**/*.ckpt
**/*.bin

################
# 4. Docker & misc
################
**/*.log
# override files that shouldn’t be tracked
Dockerfile.local
docker-compose.override.yml

################
# 5. IDE / Editor
################
.vscode/
.idea/
*.swp
*~

################
# 6. OS-specific
################
.DS_Store
Thumbs.db
Icon?

frontend/node_modules/
frontend/.expo/
frontend/.env.local
frontend/.env.production

# Python cache files
*.pyc

# Private Documentation (personal notes, prompts, internal analysis)
docs/API_ENDPOINTS.md
docs/AWS_BEDROCK_USAGE.md
docs/BUSINESS_STRATEGY_PROMPT.md
docs/IMPROVEMENT_PROMPT.md
docs/ANALISIS_INCONSISTENCIAS.md
docs/TROUBLESHOOTING-RECEIPT-PROCESSING.md
docs/IMPROVEMENTS_SUMMARY.md
docs/ARCHITECTURE_IMPROVEMENTS.md

################
# 7. Test & Sample Files
################
# Test results
test-results/
**/test-results/

# Sample images and test data
samples/
**/samples/

# Agent workflows (optional - can be kept if useful)
.agent/

# Sample data files
**/src/data/*.json
!**/src/data/.gitkeep

# Design source files (large binary files)
**/*.ai
**/*.psd
docs/*.ai
docs/*.psd
docs/*.mp4
