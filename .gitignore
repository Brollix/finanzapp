# -------------------------------
# 📦 Finanzapp .gitignore
# Monorepo: Node/Expo + Python + Docker
# -------------------------------

###############################
# 1. Node / React-Native / Expo
###############################
**/node_modules/
**/.expo/
# Web build artifacts
**/web-build/

# Env & config
**/.env
**/.env.*

# Logs & reports
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/coverage/

# iOS / Android artifacts (RN eject)
ios/
android/
*.keystore

################
# 2. Python
################
# Virtual environments
**/venv/
**/env/
**/.venv/

# Byte-compiled / cache
**/__pycache__/
**/*.py[cod]

# Packaging
# Remove build artifacts regardless of language
**/build/
**/dist/
**/*.egg-info/

################
# 3. Model files
backend/models/*
!backend/models/.gitkeep
!backend/models/README.md
################
**/*.gguf
**/*.pt
**/*.ckpt
**/*.bin

################
# 4. Docker & misc
################
**/*.log
# override files that shouldn’t be tracked
Dockerfile.local
docker-compose.override.yml

################
# 5. IDE / Editor
################
.vscode/
.idea/
*.swp
*~

################
# 6. OS-specific
################
.DS_Store
Thumbs.db
Icon?

frontend/node_modules/
frontend/.expo/
frontend/.env.local
frontend/.env.production

# Python virtual environments
backend/gpt-api/venv/
backend/ocr-api/venv/

# Python cache files
*.pyc

