# Default to LF for all text files
* text=auto eol=lf

# LFS for Video Files
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# Explicitly declare text files to ensure LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.sql text eol=lf

# Shell scripts must be LF to work on Linux/Mac
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files must be CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files (images, fonts, archives) - treat as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.jar binary
*.zip binary
*.tar.gz binary
