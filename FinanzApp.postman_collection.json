	},
	"item": [
		{
			"name": "Receipts",
			"item": [
				{
					"name": "Get My Receipts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/receipt/user/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"receipt",
								"user",
								"me"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Receipt By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/receipt/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"receipt",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{receipt_id}}",
									"description": "ID of the receipt"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Process Receipt (Image)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "image",
									"type": "file",
									"description": "Select a receipt image file (jpg, png)"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/receipt/process",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"receipt",
								"process"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Manual Receipt",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"receiptData\": {\n        \"supermarket\": \"Supermercado Test\",\n        \"datetime\": \"01/12/2025, 10:30 PM\",\n        \"items\": [\n            {\n                \"product\": \"Leche\",\n                \"quantity\": 2,\n                \"price\": 2500,\n                \"is_weight\": false\n            },\n            {\n                \"product\": \"Pan\",\n                \"quantity\": 1,\n                \"price\": 1500\n            }\n        ]\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/receipt/manual",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"receipt",
								"manual"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Receipt",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"receiptData\": {\n        \"supermarket\": \"Supermercado Editado\",\n        \"datetime\": \"01/12/2025, 11:00 PM\",\n        \"items\": [\n            {\n                \"product\": \"Leche\",\n                \"quantity\": 2,\n                \"price\": 2600\n            }\n        ]\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/receipt/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"receipt",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{receipt_id}}"
								}
							]
						}
					},
					"response": []
				}
			]
		}
	],
