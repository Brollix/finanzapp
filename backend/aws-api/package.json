{
  "name": "finanzapp-aws-api",
  "version": "1.4.5",
  "description": "FinanzApp backend with AWS Textract, Bedrock, and Supabase",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:optimization": "npm run build && node dist/scripts/test_optimization.js",
    "test:timing": "npm run build && node dist/scripts/test_timing_analysis.js",
    "benchmark": "npm run build && node dist/src/scripts/benchmark.js"
  },
  "keywords": [
    "finanzapp",
    "aws",
    "textract",
    "bedrock",
    "supabase"
  ],
  "author": "Agustín Brollo",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.716.0",
    "@aws-sdk/client-textract": "^3.716.0",
    "@supabase/supabase-js": "^2.53.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "@sentry/node": "^8.48.0",
    "@sentry/profiling-node": "^8.48.0",
    "sharp": "^0.33.5",
    "p-retry": "^4.6.0",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "nock": "^13.5.5",
    "prettier": "^3.3.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}