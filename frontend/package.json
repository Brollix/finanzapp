{
	"name": "finanzapp",
	"main": "expo-router/entry",
	"version": "1.6.0",
	"scripts": {
		"start": "expo start",
		"start:local": "expo start --clear --tunnel",
		"start:prod": "expo start --clear --tunnel",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"lint": "eslint . --ext .ts,.tsx",
		"lint:fix": "eslint . --ext .ts,.tsx --fix",
		"format": "prettier --write \"**/*.{ts,tsx,json}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
		"build:android:preview": "eas build --platform android --profile preview",
		"build:ios:preview": "eas build --platform ios --profile preview",
		"build:android": "eas build --platform android --profile production",
		"build:ios": "eas build --platform ios --profile production",
		"build:all": "eas build --platform all --profile production",
		"submit:android": "eas submit --platform android",
		"submit:ios": "eas submit --platform ios",
		"prebuild": "expo prebuild --clean"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "8.4.4",
		"@react-navigation/native": "^7.1.6",
		"@supabase/supabase-js": "^2.53.0",
		"expo": "~54.0.29",
		"expo-blur": "~15.0.8",
		"expo-camera": "~17.0.10",
		"expo-constants": "~18.0.10",
		"expo-font": "~14.0.9",
		"expo-haptics": "~15.0.8",
		"expo-image-manipulator": "~14.0.8",
		"expo-image-picker": "~17.0.10",
		"expo-linking": "~8.0.10",
		"expo-router": "~6.0.19",
		"expo-splash-screen": "~31.0.12",
		"expo-status-bar": "~3.0.9",
		"expo-system-ui": "~6.0.9",
		"expo-web-browser": "~15.0.10",
		"react": "19.1.0",
		"react-dom": "19.2.3",
		"react-native": "0.81.5",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-web": "^0.21.0",
		"react-native-webview": "13.15.0",
		"react-native-worklets": "0.5.1"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@testing-library/jest-native": "^5.4.3",
		"@testing-library/react-native": "^12.4.3",
		"@types/jest": "^29.5.11",
		"@types/react": "~19.1.10",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"babel-plugin-module-resolver": "^5.0.2",
		"cross-env": "^10.1.0",
		"eslint": "^9.0.0",
		"eslint-config-expo": "^7.1.0",
		"eslint-config-prettier": "^9.1.0",
		"jest": "^29.7.0",
		"jest-expo": "^52.0.5",
		"prettier": "^3.3.0",
		"react-test-renderer": "19.1.0",
		"typescript": "~5.9.2"
	},
	"private": true
}
