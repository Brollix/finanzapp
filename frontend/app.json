{
  "expo": {
    "name": "finanzapp",
    "slug": "finanzapp",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "finanzapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "http://192.168.0.152:8000",
      "SUPABASE_URL": "YOUR_SUPABASE_URL",
      "SUPABASE_ANON_KEY": "YOUR_SUPABASE_ANON_KEY"
    }
  }
}