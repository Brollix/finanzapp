# Finanzapp – .gitignore
# Adapted for Expo React Native + TypeScript

###########################
# Node / package managers #
###########################
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

########################
# Expo / React Native  #
########################
.expo/
.expo-shared/
.expo-env.json
expo-env.d.ts
dist/
web-build/

# Metro
.metro-cache/
.metro-health-check*

############################
# Native build artefacts   #
############################
ios/
android/
*.apk
*.aab

########################
# Build output / tests #
########################
build/
coverage/
*.tsbuildinfo

########################
# Environment files    #
########################
.env
.env.*
!.env.example

########################
# Certificates / keys  #
########################
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

########################
# IDE / OS cruft       #
########################
.vscode/
.idea/
.DS_Store
Thumbs.db


# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
